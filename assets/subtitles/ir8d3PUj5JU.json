    {
      "start": 860.32,
      "end": 863.829,
      "text": "突出中频。"
    },
    {
      "start": 863.839,
      "end": 866.079,
      "text": "然后使用成像器来"
    },
    {
      "start": 866.079,
      "end": 868.91,
      "text": "缩小"
