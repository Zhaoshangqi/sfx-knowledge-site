    },
    {
      "start": 444.16,
      "end": 445.52,
      "text": "一些 一些"
    },
    {
      "start": 445.52,
      "end": 447.199,
      "text": "一些 处理，比如均衡、一些"
    },
    {
      "start": 447.199,
      "end": 448.24,
      "text": "失真 失真"
    },
    {
      "start": 448.24,
      "end": 450.72,
      "text": "失真 和一些音高调制，让它"
    },
    {
      "start": 450.72,
      "end": 452.56,
      "text": "更好地契合"
    },
    {
      "start": 452.56,
