{
  "videoId": "lLTbxhK_QLU",
  "language": "zh-CN",
  "source": "site-owned-from-public-captions",
  "reviewStatus": "draft",
  "updatedAt": "2026-08-17",
  "cues": [
    {
      "start": 18,
      "end": 19.52,
      "text": "前几天工作时，我需要"
    },
    {
      "start": 19.52,
      "end": 21.68,
      "text": "制作一些水系法术音效。同时"
    },
    {
      "start": 21.68,
      "end": 22.96,
      "text": "我那阵子也玩了很多"
    },
    {
      "start": 22.96,
      "end": 25.279,
      "text": "《Overwatch》。角色 Wuyang"
    },
    {
      "start": 25.279,
      "end": 27.76,
      "text": "的技能里有许多很酷、很有音调感的"
    },
    {
      "start": 27.76,
      "end": 30.56,
      "text": "水声源素材。"
    },
    {
      "start": 30.56,
      "end": 32.48,
      "text": "后来我找到了一套很棒的"
    },
    {
      "start": 32.48,
      "end": 34.399,
      "text": "Sound Ideas《Sonic Water FX》"
    },
    {
      "start": 34.399,
      "end": 36.64,
      "text": "音效库，里面有"
    },
    {
      "start": 36.64,
      "end": 39.12,
      "text": "大量优秀的音调感素材，"
    },
    {
      "start": 39.12,
      "end": 42.239,
      "text": "轻柔、滴水、湿润又有水感，"
    },
    {
      "start": 42.239,
      "end": 44.32,
      "text": "让整个制作过程"
    },
    {
      "start": 44.32,
      "end": 47.039,
      "text": "轻松了许多。先听几个"
    },
    {
      "start": 47.039,
      "end": 48.8,
      "text": "我从这套音效库中选用的"
    },
    {
      "start": 48.8,
      "end": 62.069,
      "text": "未处理源素材。"
    },
    {
      "start": 62.079,
      "end": 64.239,
      "text": "接着把它们送入"
    },
    {
      "start": 64.239,
      "end": 66.56,
      "text": "多条插件效果链，充分"
    },
    {
      "start": 66.56,
      "end": 68.4,
      "text": "拼接重组后，"
    },
    {
      "start": 68.4,
      "end": 97.109,
      "text": "会变成这样。"
    },
    {
      "start": 97.119,
      "end": 98.799,
      "text": "这就是我常用的"
    },
    {
      "start": 98.799,
      "end": 100.56,
      "text": "处理思路：先从"
    },
    {
      "start": 100.56,
      "end": 102.799,
      "text": "听感很好的源素材开始。"
    },
    {
      "start": 102.799,
      "end": 104.64,
      "text": "素材本身好听很重要，"
    },
    {
      "start": 104.64,
      "end": 106.479,
      "text": "还要有丰富的声音特质。"
    },
    {
      "start": 106.479,
      "end": 108.72,
      "text": "然后我会把它送进"
    },
    {
      "start": 108.72,
      "end": 110.32,
      "text": "多条效果链，"
    },
    {
      "start": 110.32,
      "end": 112.24,
      "text": "再用多普勒插件生成许多掠过声"
    },
    {
      "start": 112.24,
      "end": 114.88,
      "text": "和冲击层。"
    },
    {
      "start": 114.88,
      "end": 116.56,
      "text": "这样进入正式设计"
    },
    {
      "start": 116.56,
      "end": 119.119,
      "text": "阶段时，基本只需把"
    },
    {
      "start": 119.119,
      "end": 121.439,
      "text": "声音对齐画面。先听未经"
    },
    {
      "start": 121.439,
      "end": 125.67,
      "text": "任何插件效果链的版本，"
    },
    {
      "start": 125.68,
      "end": 133.67,
      "text": "再听处理后。"
    },
    {
      "start": 133.68,
      "end": 135.28,
      "text": "下面简单讲讲"
    },
    {
      "start": 135.28,
      "end": 138.239,
      "text": "我是怎样得到这个声音的。"
    },
    {
      "start": 138.239,
      "end": 139.68,
      "text": "逐个来看。先用"
    },
    {
      "start": 139.68,
      "end": 141.68,
      "text": "Bloom，为声音增加"
    },
    {
      "start": 141.68,
      "end": 145.04,
      "text": "一些音调感。"
    },
    {
      "start": 145.04,
      "end": 147.2,
      "text": "然后是 MHarmonizerMB，"
    },
    {
      "start": 147.2,
      "end": 152.07,
      "text": "补充高频。"
    },
    {
      "start": 152.08,
      "end": 154.48,
      "text": "接着用 OTT 带出更多"
    },
    {
      "start": 154.48,
      "end": 158.63,
      "text": "频段细节。"
    },
    {
      "start": 158.64,
      "end": 161.04,
      "text": "然后用了从 Michael Cheung 那里学到的"
    },
    {
      "start": 161.04,
      "end": 163.28,
      "text": "MVocoder 技巧。老实说"
    },
    {
      "start": 163.28,
      "end": 165.2,
      "text": "我也不完全清楚原理，但"
    },
    {
      "start": 165.2,
      "end": 167.12,
      "text": "勾选这两个默认未勾选的选项，"
    },
    {
      "start": 167.12,
      "end": 169.519,
      "text": "它似乎就会把"
    },
    {
      "start": 169.519,
      "end": 172.16,
      "text": "声音自身路由进声码器，"
    },
    {
      "start": 172.16,
      "end": 177.19,
      "text": "让整体听起来更湿润。"
    },
    {
      "start": 177.2,
      "end": 179.44,
      "text": "再用 Bloom 强化原有的"
    },
    {
      "start": 179.44,
      "end": 182.949,
      "text": "音调感。"
    },
    {
      "start": 182.959,
      "end": 185.04,
      "text": "接着是 Snap Heap，我把它当作"
    },
    {
      "start": 185.04,
      "end": 186.879,
      "text": "多普勒工具。这里是很简单的"
    },
    {
      "start": 186.879,
      "end": 189.44,
      "text": "随机化 LFO，"
    },
    {
      "start": 189.44,
      "end": 191.76,
      "text": "让 LFO 控制移调器、"
    },
    {
      "start": 191.76,
      "end": 194.56,
      "text": "滤波器包络，以及少量"
    },
    {
      "start": 194.56,
      "end": 198.79,
      "text": "增益。"
    },
    {
      "start": 198.8,
      "end": 202.159,
      "text": "再用 Hybrid Filter"
    },
    {
      "start": 202.159,
      "end": 208.47,
      "text": "增加动态变化。"
    },
    {
      "start": 208.48,
      "end": 212.07,
      "text": "接着是 Crystallizer。"
    },
    {
      "start": 212.08,
      "end": 214.08,
      "text": "然后再加 Bloom，继续"
    },
    {
      "start": 214.08,
      "end": 219.91,
      "text": "强化音调感。"
    },
    {
      "start": 219.92,
      "end": 223.68,
      "text": "再用颗粒合成器 MGranularMB，"
    },
    {
      "start": 223.68,
      "end": 225.68,
      "text": "它能把声音的"
    },
    {
      "start": 225.68,
      "end": 227.28,
      "text": "尾部拉长，效果很好。"
    },
    {
      "start": 227.28,
      "end": 234.71,
      "text": "我就是这样使用它的。"
    },
    {
      "start": 234.72,
      "end": 236.239,
      "text": "所有延迟感都来自这里。"
    },
    {
      "start": 236.239,
      "end": 238.879,
      "text": "然后再加一个 OTT，"
    },
    {
      "start": 238.879,
      "end": 242.48,
      "text": "重新带出各频段。"
    },
    {
      "start": 242.48,
      "end": 248.229,
      "text": "最后再开一个 Snap Heap。"
    },
    {
      "start": 248.239,
      "end": 250.4,
      "text": "它主要用于清理"
    },
    {
      "start": 250.4,
      "end": 253.2,
      "text": "颗粒合成产生的无限反馈，"
    },
    {
      "start": 253.2,
      "end": 256.32,
      "text": "让声音更干净。接着看"
    },
    {
      "start": 256.32,
      "end": 261.11,
      "text": "这一条。"
    },
    {
      "start": 261.12,
      "end": 269.27,
      "text": "这是处理前和处理后的对比。"
    },
    {
      "start": 269.28,
      "end": 273.909,
      "text": "先用 Hybrid Filter 增加动态变化。"
    },
    {
      "start": 273.919,
      "end": 278.31,
      "text": "接着是 Spectral Gate，"
    },
    {
      "start": 278.32,
      "end": 281.28,
      "text": "再加 Bloom。"
    },
    {
      "start": 281.28,
      "end": 283.44,
      "text": "然后只补一点"
    },
    {
      "start": 283.44,
      "end": 287.03,
      "text": "增益。"
    },
    {
      "start": 287.04,
      "end": 291.03,
      "text": "再用一次 Bloom。"
    },
    {
      "start": 291.04,
      "end": 297.83,
      "text": "接着是第一个 SpinTracer。"
    },
    {
      "start": 297.84,
      "end": 299.6,
      "text": "这里我大概把它"
    },
    {
      "start": 299.6,
      "end": 302.72,
      "text": "作为合奏式处理，并增加动态变化。"
    },
    {
      "start": 302.72,
      "end": 305.68,
      "text": "MRatioMB 用来削减"
    },
    {
      "start": 305.68,
      "end": 309.189,
      "text": "噪声。"
    },
    {
      "start": 309.199,
      "end": 314.469,
      "text": "PhaseMistress 用来增加动态变化，"
    },
    {
      "start": 314.479,
      "end": 316.72,
      "text": "随后用 SpinTracer 控制"
    },
    {
      "start": 316.72,
      "end": 321.35,
      "text": "掠过声。"
    },
    {
      "start": 321.36,
      "end": 324.16,
      "text": "最后补一点低频。其实"
    },
    {
      "start": 324.16,
      "end": 332.71,
      "text": "这样可能更合适。"
    },
    {
      "start": 332.72,
      "end": 335.039,
      "text": "下一条我很喜欢，"
    },
    {
      "start": 335.039,
      "end": 337.919,
      "text": "因为发现了一个很酷的技巧。"
    },
    {
      "start": 337.919,
      "end": 341.68,
      "text": "原始声音是这样，"
    },
    {
      "start": 341.68,
      "end": 348.87,
      "text": "处理后会非常湿润。"
    },
    {
      "start": 348.88,
      "end": 351.6,
      "text": "这主要来自 RX De-crackle。"
    },
    {
      "start": 351.6,
      "end": 353.52,
      "text": "下面按效果链讲解。"
    },
    {
      "start": 353.52,
      "end": 356.56,
      "text": "先用 Bloom 带出"
    },
    {
      "start": 356.56,
      "end": 359.759,
      "text": "一些频段，同时削掉"
    },
    {
      "start": 359.759,
      "end": 363.039,
      "text": "部分高频；再用 Warp"
    },
    {
      "start": 363.039,
      "end": 369.43,
      "text": "拉伸声音。"
    },
    {
      "start": 369.44,
      "end": 372.4,
      "text": "然后把 RX De-crackle 设为"
    },
    {
      "start": 372.4,
      "end": 374.639,
      "text": "Output Crackle Only 模式，"
    },
    {
      "start": 374.639,
      "end": 378.23,
      "text": "这是这个采样的关键。"
    },
    {
      "start": 378.24,
      "end": 382.629,
      "text": "处理前是这样。"
    },
    {
      "start": 382.639,
      "end": 384.639,
      "text": "只输出爆裂声后，"
    },
    {
      "start": 384.639,
      "end": 386.4,
      "text": "会得到这些很有湿润感的"
    },
    {
      "start": 386.4,
      "end": 390.95,
      "text": "纹理。"
    },
    {
      "start": 390.96,
      "end": 392.96,
      "text": "我立刻想把它们"
    },
    {
      "start": 392.96,
      "end": 394.72,
      "text": "放大，于是用 Cluster Delay"
    },
    {
      "start": 394.72,
      "end": 399.909,
      "text": "加入更多延迟。"
    },
    {
      "start": 399.919,
      "end": 402.08,
      "text": "再用 EQ，避免出现"
    },
    {
      "start": 402.08,
      "end": 403.759,
      "text": "低频爆点，"
    },
    {
      "start": 403.759,
      "end": 408.309,
      "text": "只保留高频。"
    },
    {
      "start": 408.319,
      "end": 413.749,
      "text": "接着用一个 Crystallizer，"
    },
    {
      "start": 413.759,
      "end": 416.72,
      "text": "再复制三份，"
    },
    {
      "start": 416.72,
      "end": 419.039,
      "text": "让这种"
    },
    {
      "start": 419.039,
      "end": 425.11,
      "text": "晶莹闪烁的细节更多。"
    },
    {
      "start": 425.12,
      "end": 427.919,
      "text": "然后用 Saturn 的饱和"
    },
    {
      "start": 427.919,
      "end": 432.469,
      "text": "带出音调感。"
    },
    {
      "start": 432.479,
      "end": 434.4,
      "text": "最后再把它送入"
    },
    {
      "start": 434.4,
      "end": 437.12,
      "text": "Snap Heap 的掠过效果，"
    },
    {
      "start": 437.12,
      "end": 439.68,
      "text": "并加入一个 Filter Table，"
    },
    {
      "start": 439.68,
      "end": 443.919,
      "text": "像移相器一样上下扫动。"
    },
    {
      "start": 443.919,
      "end": 447.36,
      "text": "关闭 Filter Table 时，"
    },
    {
      "start": 447.36,
      "end": 448.88,
      "text": "声音本来也不错；"
    },
    {
      "start": 448.88,
      "end": 451.919,
      "text": "开启后会增加一点"
    },
    {
      "start": 451.919,
      "end": 454.08,
      "text": "动态变化。然后提升"
    },
    {
      "start": 454.08,
      "end": 456.56,
      "text": "增益，让它更响。"
    },
    {
      "start": 456.56,
      "end": 458.639,
      "text": "最后限幅，确保"
    },
    {
      "start": 458.639,
      "end": 461.44,
      "text": "不会削波。"
    },
    {
      "start": 461.44,
      "end": 463.759,
      "text": "好，这一条在"
    },
    {
      "start": 463.759,
      "end": 467.199,
      "text": "处理前是这样。"
    },
    {
      "start": 467.199,
      "end": 469.12,
      "text": "处理后是这样。我会用"
    },
    {
      "start": 469.12,
      "end": 472.08,
      "text": "XY Pad 控制掠过声，"
    },
    {
      "start": 472.08,
      "end": 474.24,
      "text": "给自己多一点变化。处理后"
    },
    {
      "start": 474.24,
      "end": 483.11,
      "text": "是这样。"
    },
    {
      "start": 483.12,
      "end": 485.44,
      "text": "XY Pad 控制低通"
    },
    {
      "start": 485.44,
      "end": 487.84,
      "text": "滤波器。向这个方向移动时，"
    },
    {
      "start": 487.84,
      "end": 490.639,
      "text": "滤波器会跟着变化；"
    },
    {
      "start": 490.639,
      "end": 492.96,
      "text": "它也控制增益。上下"
    },
    {
      "start": 492.96,
      "end": 495.28,
      "text": "移动时，增益会"
    },
    {
      "start": 495.28,
      "end": 497.039,
      "text": "升高或降低，因此我能"
    },
    {
      "start": 497.039,
      "end": 500.479,
      "text": "亲手塑造动态变化。先"
    },
    {
      "start": 500.479,
      "end": 504.15,
      "text": "用 Crystallizer 处理，"
    },
    {
      "start": 504.16,
      "end": 506.319,
      "text": "再用 MRatioMB 只保留"
    },
    {
      "start": 506.319,
      "end": 509.919,
      "text": "音调元素。"
    },
    {
      "start": 509.919,
      "end": 513.519,
      "text": "L2 用来增加增益。"
    },
    {
      "start": 513.519,
      "end": 515.919,
      "text": "再用 Spectral Gate，继续聚焦"
    },
    {
      "start": 515.919,
      "end": 518.719,
      "text": "音调元素。"
    },
    {
      "start": 518.719,
      "end": 521.919,
      "text": "然后补更多增益。"
    },
    {
      "start": 521.919,
      "end": 524.88,
      "text": "MHarmonizerMB 加入频谱"
    },
    {
      "start": 524.88,
      "end": 526.72,
      "text": "合唱效果，也就是"
    },
    {
      "start": 526.72,
      "end": 528.959,
      "text": "更高频的一点频谱质感。"
    },
    {
      "start": 528.959,
      "end": 533.839,
      "text": "Bloom 用来提升这些频段。"
    },
    {
      "start": 533.839,
      "end": 538.07,
      "text": "Hybrid Filter 增加动态变化。"
    },
    {
      "start": 538.08,
      "end": 539.76,
      "text": "这里还用 Hybrid Filter"
    },
    {
      "start": 539.76,
      "end": 545.509,
      "text": "随机调节 Spread。"
    },
    {
      "start": 545.519,
      "end": 547.839,
      "text": "就是这里。我用"
    },
    {
      "start": 547.839,
      "end": 551.12,
      "text": "随机 LFO 插件控制 Spread，"
    },
    {
      "start": 551.12,
      "end": 553.36,
      "text": "同时也控制截止"
    },
    {
      "start": 553.36,
      "end": 558.87,
      "text": "频率。之后用 Pro-L 2"
    },
    {
      "start": 558.88,
      "end": 561.44,
      "text": "补回增益，再用颗粒"
    },
    {
      "start": 561.44,
      "end": 563.68,
      "text": "合成随机改变部分"
    },
    {
      "start": 563.68,
      "end": 567.43,
      "text": "尾音。"
    },
    {
      "start": 567.44,
      "end": 569.04,
      "text": "接着用滤波器削掉一些"
    },
    {
      "start": 569.04,
      "end": 571.519,
      "text": "高频。其实不对，抱歉，"
    },
    {
      "start": 571.519,
      "end": 573.12,
      "text": "这是由"
    },
    {
      "start": 573.12,
      "end": 575.68,
      "text": "XY Pad 控制的滤波器。"
    },
    {
      "start": 575.68,
      "end": 577.04,
      "text": "然后是 XY Pad 控制的增益，"
    },
    {
      "start": 577.04,
      "end": 580.16,
      "text": "再用 Frontier"
    },
    {
      "start": 580.16,
      "end": 582.88,
      "text": "确保不削波。制作"
    },
    {
      "start": 582.88,
      "end": 585.2,
      "text": "最初的声音时，"
    },
    {
      "start": 585.2,
      "end": 587.519,
      "text": "我有很多很酷的低沉水声"
    },
    {
      "start": 587.519,
      "end": 589.519,
      "text": "源素材，却觉得"
    },
    {
      "start": 589.519,
      "end": 592.16,
      "text": "缺少闪烁感，"
    },
    {
      "start": 592.16,
      "end": 594.56,
      "text": "也就是魔法感。于是我专门"
    },
    {
      "start": 594.56,
      "end": 596.32,
      "text": "回来寻找这种魔法"
    },
    {
      "start": 596.32,
      "end": 598.32,
      "text": "元素，做出了这个。"
    },
    {
      "start": 598.32,
      "end": 601.04,
      "text": "处理前，"
    },
    {
      "start": 601.04,
      "end": 606.23,
      "text": "处理后。"
    },
    {
      "start": 606.24,
      "end": 608.399,
      "text": "下面看效果链："
    },
    {
      "start": 608.399,
      "end": 612.87,
      "text": "先是 Bloom，"
    },
    {
      "start": 612.88,
      "end": 616.71,
      "text": "再是 Crystallizer。"
    },
    {
      "start": 616.72,
      "end": 620.72,
      "text": "用 Pro-Q 3 清理低频。"
    },
    {
      "start": 620.72,
      "end": 622.959,
      "text": "再用颗粒合成器"
    },
    {
      "start": 622.959,
      "end": 627.829,
      "text": "做更激进的颗粒变化。"
    },
    {
      "start": 627.839,
      "end": 629.76,
      "text": "然后再次清理"
    },
    {
      "start": 629.76,
      "end": 633.19,
      "text": "低频。"
    },
    {
      "start": 633.2,
      "end": 634.72,
      "text": "FilterFreak 用来增加"
    },
    {
      "start": 634.72,
      "end": 639.35,
      "text": "动态变化。"
    },
    {
      "start": 639.36,
      "end": 642.959,
      "text": "接着是 UZU，它有点像"
    },
    {
      "start": 642.959,
      "end": 646.56,
      "text": "频移类的频谱处理器，"
    },
    {
      "start": 646.56,
      "end": 648.16,
      "text": "听起来很酷，尤其"
    },
    {
      "start": 648.16,
      "end": 649.6,
      "text": "提升增益后才"
    },
    {
      "start": 649.6,
      "end": 653.032,
      "text": "能清楚听见。"
    },
    {
      "start": 658.48,
      "end": 661.6,
      "text": "我很喜欢这个插件。再用 OTT"
    },
    {
      "start": 661.6,
      "end": 664.8,
      "text": "做频谱平衡。"
    },
    {
      "start": 664.8,
      "end": 666.8,
      "text": "Soothe2 用来柔化"
    },
    {
      "start": 666.8,
      "end": 668.8,
      "text": "部分高频。"
    },
    {
      "start": 668.8,
      "end": 672.8,
      "text": "PhaseMistress 增加动态变化。"
    },
    {
      "start": 672.8,
      "end": 674.8,
      "text": "再来一个 PhaseMistress，增加更多"
    },
    {
      "start": 674.8,
      "end": 676.88,
      "text": "动态变化。"
    },
    {
      "start": 676.88,
      "end": 679.68,
      "text": "最后用 L2 提升增益。"
    },
    {
      "start": 679.68,
      "end": 681.44,
      "text": "再用 SpinTracer 调制"
    },
    {
      "start": 681.44,
      "end": 686.23,
      "text": "声音。"
    },
    {
      "start": 686.24,
      "end": 688.8,
      "text": "有了初始水声采样后，"
    },
    {
      "start": 688.8,
      "end": 690.399,
      "text": "我还想做些有音调感的"
    },
    {
      "start": 690.399,
      "end": 692.48,
      "text": "魔法素材，于是取出之前的 UZU"
    },
    {
      "start": 692.48,
      "end": 694.88,
      "text": "插件，专门"
    },
    {
      "start": 694.88,
      "end": 696.88,
      "text": "提取其中具有魔法感的音调"
    },
    {
      "start": 696.88,
      "end": 698.959,
      "text": "素材。处理前"
    },
    {
      "start": 698.959,
      "end": 702.389,
      "text": "是这样，"
    },
    {
      "start": 702.399,
      "end": 704.788,
      "text": "处理后是这样。"
    },
    {
      "start": 704.788,
      "end": 706.15,
      "text": "【音乐】"
    },
    {
      "start": 706.16,
      "end": 708,
      "text": "【音乐】这基本全由 UZU 完成。"
    },
    {
      "start": 708,
      "end": 710.8,
      "text": "我重复做了几次，"
    },
    {
      "start": 710.8,
      "end": 712.32,
      "text": "从中得到不同的"
    },
    {
      "start": 712.32,
      "end": 715.2,
      "text": "纹理。"
    },
    {
      "start": 715.2,
      "end": 717.36,
      "text": "随后把它们降调，"
    },
    {
      "start": 717.36,
      "end": 719.04,
      "text": "因为原素材有很不错的"
    },
    {
      "start": 719.04,
      "end": 726.23,
      "text": "高频内容。"
    },
    {
      "start": 726.24,
      "end": 728.959,
      "text": "源素材准备好后，"
    },
    {
      "start": 728.959,
      "end": 730.48,
      "text": "剩下就是把它们"
    },
    {
      "start": 730.48,
      "end": 733.44,
      "text": "与画面对齐。最简单的"
    },
    {
      "start": 733.44,
      "end": 734.88,
      "text": "讲法，是先展示"
    },
    {
      "start": 734.88,
      "end": 737.279,
      "text": "这些掠过声，因为处理并不"
    },
    {
      "start": 737.279,
      "end": 739.6,
      "text": "复杂，只是把"
    },
    {
      "start": 739.6,
      "end": 741.2,
      "text": "声音对齐，几乎"
    },
    {
      "start": 741.2,
      "end": 743.68,
      "text": "没有额外处理。"
    },
    {
      "start": 743.68,
      "end": 748.23,
      "text": "这是一个短促的起始声，"
    },
    {
      "start": 748.24,
      "end": 749.92,
      "text": "由之前做出的三条采样"
    },
    {
      "start": 749.92,
      "end": 754.87,
      "text": "组成。"
    },
    {
      "start": 754.88,
      "end": 757.44,
      "text": "第一条掠过声"
    },
    {
      "start": 757.44,
      "end": 759.2,
      "text": "是这样。下面先听"
    },
    {
      "start": 759.2,
      "end": 762.56,
      "text": "整组水声素材，"
    },
    {
      "start": 762.56,
      "end": 771.19,
      "text": "再逐条独奏。"
    },
    {
      "start": 771.2,
      "end": 773.12,
      "text": "同样几乎没有处理。"
    },
    {
      "start": 773.12,
      "end": 775.44,
      "text": "我只用 Imager 收窄"
    },
    {
      "start": 775.44,
      "end": 777.92,
      "text": "立体声宽度，再做"
    },
    {
      "start": 777.92,
      "end": 780.16,
      "text": "少量 EQ，"
    },
    {
      "start": 780.16,
      "end": 781.92,
      "text": "去掉声音的浑浊感。"
    },
    {
      "start": 781.92,
      "end": 784.16,
      "text": "然后是第二条掠过声，"
    },
    {
      "start": 784.16,
      "end": 788.949,
      "text": "也是最大的一条。"
    },
    {
      "start": 788.959,
      "end": 791.76,
      "text": "单独听是这样。"
    },
    {
      "start": 791.76,
      "end": 793.04,
      "text": "这里也只有少量"
    },
    {
      "start": 793.04,
      "end": 795.12,
      "text": "处理：实际上没有 EQ，"
    },
    {
      "start": 795.12,
      "end": 797.36,
      "text": "只用 MHarmonizer"
    },
    {
      "start": 797.36,
      "end": 799.279,
      "text": "补充高频。接着是"
    },
    {
      "start": 799.279,
      "end": 808.15,
      "text": "其他有水感的素材，"
    },
    {
      "start": 808.16,
      "end": 812.79,
      "text": "最后一条掠过声。"
    },
    {
      "start": 812.8,
      "end": 814.32,
      "text": "它只使用之前做好的"
    },
    {
      "start": 814.32,
      "end": 816.24,
      "text": "那些采样，"
    },
    {
      "start": 816.24,
      "end": 825.829,
      "text": "每条都只做了轻微 EQ。"
    },
    {
      "start": 825.839,
      "end": 827.68,
      "text": "这些就是全部水声掠过层。"
    },
    {
      "start": 827.68,
      "end": 830.88,
      "text": "如果只独奏这些水声掠过层，"
    },
    {
      "start": 830.88,
      "end": 839.67,
      "text": "听起来是这样。"
    },
    {
      "start": 839.68,
      "end": 841.12,
      "text": "但我觉得非常缺少"
    },
    {
      "start": 841.12,
      "end": 843.68,
      "text": "有音调感的魔法元素。"
    },
    {
      "start": 843.68,
      "end": 849.11,
      "text": "起初我加了这些素材，"
    },
    {
      "start": 849.12,
      "end": 851.76,
      "text": "效果不错，但还需要"
    },
    {
      "start": 851.76,
      "end": 853.36,
      "text": "更多高频细节，于是"
    },
    {
      "start": 853.36,
      "end": 855.44,
      "text": "我回头制作了"
    },
    {
      "start": 855.44,
      "end": 861.11,
      "text": "刚才展示的水花闪烁层。"
    },
    {
      "start": 861.12,
      "end": 863.279,
      "text": "把它和前面的素材"
    },
    {
      "start": 863.279,
      "end": 870.15,
      "text": "一起播放后，"
    },
    {
      "start": 870.16,
      "end": 871.68,
      "text": "它会让耳朵"
    },
    {
      "start": 871.68,
      "end": 873.68,
      "text": "有一条可追随的运动线索。最后"
    },
    {
      "start": 873.68,
      "end": 875.76,
      "text": "是末尾水球的环境层，"
    },
    {
      "start": 875.76,
      "end": 880.23,
      "text": "听起来这样。"
    },
    {
      "start": 880.24,
      "end": 883.68,
      "text": "它就是我制作的那条"
    },
    {
      "start": 883.68,
      "end": 885.57,
      "text": "音调源素材。"
    },
    {
      "start": 885.57,
      "end": 887.35,
      "text": "【音乐】"
    },
    {
      "start": 887.36,
      "end": 889.36,
      "text": "我记得只是把它"
    },
    {
      "start": 889.36,
      "end": 893.199,
      "text": "大幅降调，"
    },
    {
      "start": 893.199,
      "end": 895.199,
      "text": "就是把那条文件"
    },
    {
      "start": 895.199,
      "end": 897.92,
      "text": "降了很多。至于这些声音，"
    },
    {
      "start": 897.92,
      "end": 899.92,
      "text": "我取了几条采样，"
    },
    {
      "start": 899.92,
      "end": 902.88,
      "text": "其中这条是闪烁素材，"
    },
    {
      "start": 902.88,
      "end": 907.43,
      "text": "再加一些"
    },
    {
      "start": 907.44,
      "end": 909.6,
      "text": "有音调感的湿润声音。然后"
    },
    {
      "start": 909.6,
      "end": 913.04,
      "text": "经过宽度处理和 EQ，"
    },
    {
      "start": 913.04,
      "end": 915.36,
      "text": "再套用一个 SpinTracer 配置，"
    },
    {
      "start": 915.36,
      "end": 919.91,
      "text": "让它们旋转。"
    },
    {
      "start": 919.92,
      "end": 923.92,
      "text": "因为水球正在旋转，"
    },
    {
      "start": 923.92,
      "end": 924.88,
      "text": "所以需要带出这种"
    },
    {
      "start": 924.88,
      "end": 926.24,
      "text": "旋转动态。最后"
    },
    {
      "start": 926.24,
      "end": 927.839,
      "text": "我想让整体听起来更"
    },
    {
      "start": 927.839,
      "end": 930.24,
      "text": "湿润，于是补了一点"
    },
    {
      "start": 930.24,
      "end": 933.829,
      "text": "那条湿润素材。"
    },
    {
      "start": 933.839,
      "end": 936,
      "text": "同样用 SpinTracer 处理。"
    },
    {
      "start": 936,
      "end": 937.92,
      "text": "最后还有"
    },
    {
      "start": 937.92,
      "end": 940.079,
      "text": "声像移动，只做轻微"
    },
    {
      "start": 940.079,
      "end": 941.92,
      "text": "平移来配合画面中"
    },
    {
      "start": 941.92,
      "end": 943.68,
      "text": "水球移向屏幕"
    },
    {
      "start": 943.68,
      "end": 948.79,
      "text": "两侧。"
    },
    {
      "start": 948.8,
      "end": 951.6,
      "text": "这样能营造"
    },
    {
      "start": 951.6,
      "end": 953.68,
      "text": "三维空间感。基本"
    },
    {
      "start": 953.68,
      "end": 956,
      "text": "就是这些。我也很喜欢"
    },
    {
      "start": 956,
      "end": 958.32,
      "text": "原版声音。"
    },
    {
      "start": 958.32,
      "end": 960.72,
      "text": "原版听起来这样，可以发现"
    },
    {
      "start": 960.72,
      "end": 969.189,
      "text": "我的灵感来源非常明显。"
    },
    {
      "start": 969.199,
      "end": 970.959,
      "text": "大致就是这样。"
    },
    {
      "start": 970.959,
      "end": 972.56,
      "text": "关键是从优质"
    },
    {
      "start": 972.56,
      "end": 974.32,
      "text": "源素材开始，"
    },
    {
      "start": 974.32,
      "end": 976.48,
      "text": "所以我很喜欢"
    },
    {
      "start": 976.48,
      "end": 979.44,
      "text": "Sound Ideas《Sonic Water FX》。"
    },
    {
      "start": 979.44,
      "end": 981.36,
      "text": "然后充分拼接重组，尽可能提取"
    },
    {
      "start": 981.36,
      "end": 983.519,
      "text": "音调素材和动态变化。"
    },
    {
      "start": 983.519,
      "end": 985.519,
      "text": "之后就很容易了。感谢"
    },
    {
      "start": 985.519,
      "end": 988.16,
      "text": "观看。"
    }
  ]
}
