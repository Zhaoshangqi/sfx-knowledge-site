{
  "videoId": "-pmOXv31j6s",
  "language": "zh-CN",
  "source": "site-owned-from-public-captions",
  "reviewStatus": "draft",
  "updatedAt": "2026-08-13",
  "cues": [
    {
      "start": 0.08,
      "end": 2.32,
      "text": "大家好，11月22日的"
    },
    {
      "start": 2.32,
      "end": 4.24,
      "text": "提示是“丝滑”，我"
    },
    {
      "start": 4.24,
      "end": 6.44,
      "text": "今天想试试Wave Warper 2，所以我"
    },
    {
      "start": 6.44,
      "end": 7.72,
      "text": "想做一些听起来很流畅的嗖嗖声。"
    },
    {
      "start": 7.72,
      "end": 9.92,
      "text": "我先 我先"
    },
    {
      "start": 9.92,
      "end": 11.44,
      "text": "我先 浏览了一些"
    },
    {
      "start": 11.44,
      "end": 13.12,
      "text": "预设，看看“嗖嗖声”文件"
    },
    {
      "start": 13.12,
      "end": 15.4,
      "text": "夹里有什么，找到了四个"
    },
    {
      "start": 15.4,
      "end": 17.119,
      "text": "我觉得可以作为基础的预设。然后"
    },
    {
      "start": 17.119,
      "end": 19.4,
      "text": "我 我"
    },
    {
      "start": 19.4,
      "end": 21.6,
      "text": "我 替换了 替换了"
    },
    {
      "start": 21.6,
      "end": 23.439,
      "text": "替换了 不同模块中的一些音频文件，有些来自"
    },
    {
      "start": 23.439,
      "end": 25.039,
      "text": "我的音乐库，有些"
    },
    {
      "start": 25.039,
      "end": 27.16,
      "text": "来自Wave Warper内置的，它有一个很大的音频库"
    },
    {
      "start": 27.16,
      "end": 28.56,
      "text": "可供选择。"
    },
    {
      "start": 28.56,
      "end": 31.16,
      "text": "第一个嗖嗖声听起来很流畅，很有活力，"
    },
    {
      "start": 31.16,
      "end": 39.31,
      "text": "我觉得"
    },
    {
      "start": 39.32,
      "end": 41.44,
      "text": "不错。你可以"
    },
    {
      "start": 41.44,
      "end": 43.2,
      "text": "通过调整"
    },
    {
      "start": 43.2,
      "end": 44.8,
      "text": "这里的打击垫来获得很多不同的音源，但"
    },
    {
      "start": 44.8,
      "end": 46.28,
      "text": "我主要调整的是音量"
    },
    {
      "start": 46.28,
      "end": 48.12,
      "text": "和速率旋钮，并让它们根据"
    },
    {
      "start": 48.12,
      "end": 50.12,
      "text": "半径或X轴"
    },
    {
      "start": 50.12,
      "end": 52.559,
      "text": "和Y轴的变化而变化。第二个嗖嗖声"
    },
    {
      "start": 52.559,
      "end": 59.9,
      "text": "听起来像这样"
    },
    {
      "start": 62.32,
      "end": 64.76,
      "text": "[音乐]， 有点太空感，"
    },
    {
      "start": 64.76,
      "end": 66.24,
      "text": "我相当确定这个…… 我"
    },
    {
      "start": 66.24,
      "end": 67.96,
      "text": "从它自带的音色库里挑选了所有采样，"
    },
    {
      "start": 67.96,
      "end": 70.62,
      "text": "所以听起来都挺像科幻"
    },
    {
      "start": 70.62,
      "end": 81.67,
      "text": "音乐的。"
    },
    {
      "start": 81.68,
      "end": 96.469,
      "text": "第三个听起来"
    },
    {
      "start": 96.479,
      "end": 97.88,
      "text": "像是某种"
    },
    {
      "start": 97.88,
      "end": 99.479,
      "text": "太空飞船的氛围音效，你可以调整它的"
    },
    {
      "start": 99.479,
      "end": 101.079,
      "text": "平滑度，如果"
    },
    {
      "start": 101.079,
      "end": 102.84,
      "text": "你想让它更快一些，"
    },
    {
      "start": 102.84,
      "end": 106.95,
      "text": "可以进行调整。"
    },
    {
      "start": 106.96,
      "end": 109.6,
      "text": "第四个也是最后一个"
    },
    {
      "start": 109.6,
      "end": 122.1,
      "text": "听起来像这样"
    },
    {
      "start": 123.92,
      "end": 125.68,
      "text": "（音乐）， 显然很像"
    },
    {
      "start": 125.68,
      "end": 129.79,
      "text": "科幻飞船的声音，里面有很多扭曲音效，单独听起来就很棒。"
    },
    {
      "start": 129.8,
      "end": 132.52,
      "text": "我敢肯定，"
    },
    {
      "start": 132.52,
      "end": 135,
      "text": "第一个音效里就有很多"
    },
    {
      "start": 135,
      "end": 138.55,
      "text": "扭曲音效，一听就很好听。我"
    },
    {
      "start": 138.56,
      "end": 140.76,
      "text": "挑选了这些采样的不同部分，在"
    },
    {
      "start": 140.76,
      "end": 143.2,
      "text": "你踩下打击"
    },
    {
      "start": 143.2,
      "end": 144.68,
      "text": "垫时播放，所有这些组合在一起，就能得到一个非常饱满、悦耳的"
    },
    {
      "start": 144.68,
      "end": 146.68,
      "text": "飞船 飞船"
    },
    {
      "start": 146.68,
      "end": 154.22,
      "text": "飞船 飞过的声音（"
    },
    {
      "start": 155.959,
      "end": 160.64,
      "text": "音乐）。 所以，这些就是我第22天制作的声音。"
    }
  ]
}
