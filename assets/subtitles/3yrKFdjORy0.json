{
  "videoId": "3yrKFdjORy0",
  "language": "zh-CN",
  "source": "site-owned-from-public-captions",
  "reviewStatus": "draft",
  "updatedAt": "2026-08-13",
  "cues": [
    {
      "start": 0.03,
      "end": 1.65,
      "text": "大家好，欢迎收看"
    },
    {
      "start": 1.65,
      "end": 3.54,
      "text": "声音设计实验第二集。在今天的"
    },
    {
      "start": 3.54,
      "end": 4.74,
      "text": "节目中，我将"
    },
    {
      "start": 4.74,
      "end": 6.48,
      "text": "详细讲解我为澳大利亚专业学生制作的"
    },
    {
      "start": 6.48,
      "end": 8.429,
      "text": "声音重制版。我会先播放一段完整的"
    },
    {
      "start": 8.429,
      "end": 10.05,
      "text": "音频，然后"
    },
    {
      "start": 10.05,
      "end": 11.58,
      "text": "讲解我是如何创建和叠加这些"
    },
    {
      "start": 11.58,
      "end": 24,
      "text": "声音的。首先，我添加了"
    },
    {
      "start": 24,
      "end": 25.41,
      "text": "环境音轨和"
    },
    {
      "start": 25.41,
      "end": 27.63,
      "text": "人物脚步声。"
    },
    {
      "start": 27.63,
      "end": 32.91,
      "text": "我录制了一层草地脚步声，还录制了"
    },
    {
      "start": 32.91,
      "end": 34.559,
      "text": "一层鸟鸣声，"
    },
    {
      "start": 34.559,
      "end": 35.94,
      "text": "以及一个从 Soundsnap 获取的瀑布声。"
    },
    {
      "start": 35.94,
      "end": 38.16,
      "text": "我调整了它们的声像位置并进行了自动化处理，使之与"
    },
    {
      "start": 38.16,
      "end": 39.96,
      "text": "画面相符。接下来，我想"
    },
    {
      "start": 39.96,
      "end": 41.579,
      "text": "重点讲解咒语的声音。正如你所"
    },
    {
      "start": 41.579,
      "end": 43.59,
      "text": "看到的，我使用了相当多的音轨来覆盖"
    },
    {
      "start": 43.59,
      "end": 44.91,
      "text": "整个声音，以确保尽可能覆盖"
    },
    {
      "start": 44.91,
      "end": 46.53,
      "text": "更多的频谱。"
    },
    {
      "start": 46.53,
      "end": 48.66,
      "text": "我最初将"
    },
    {
      "start": 48.66,
      "end": 50.82,
      "text": "咒语分为两部分："
    },
    {
      "start": 50.82,
      "end": 53.52,
      "text": "施法和爆炸。"
    },
    {
      "start": 53.52,
      "end": 55.829,
      "text": "首先是施法部分，我使用了"
    },
    {
      "start": 55.829,
      "end": 57.84,
      "text": "一段门吱呀作响的录音，并使用"
    },
    {
      "start": 57.84,
      "end": 59.85,
      "text": "侧链来塑造声音和"
    },
    {
      "start": 59.85,
      "end": 62.19,
      "text": "一些特效。我使用 Snap Heap"
    },
    {
      "start": 62.19,
      "end": 64.14,
      "text": "插件将这条音轨连接到一个总线，"
    },
    {
      "start": 64.14,
      "end": 65.939,
      "text": "该总线输出一个嗖嗖声"
    },
    {
      "start": 65.939,
      "end": 68.61,
      "text": "效果。然后，这个声音被用来制造震动效果。"
    },
    {
      "start": 68.61,
      "end": 70.26,
      "text": "门吱呀声的增益、"
    },
    {
      "start": 70.26,
      "end": 72.84,
      "text": "延迟和频率偏移，"
    },
    {
      "start": 72.84,
      "end": 74.7,
      "text": "这是干声和"
    },
    {
      "start": 74.7,
      "end": 88.999,
      "text": "添加每个效果后的声音。在"
    },
    {
      "start": 89.009,
      "end": 91.42,
      "text": "基础音效层的基础上，我"
    },
    {
      "start": 91.42,
      "end": 92.86,
      "text": "想为咒语释放创建一个声音，"
    },
    {
      "start": 92.86,
      "end": 95.17,
      "text": "所以我用了之前录制的"
    },
    {
      "start": 95.17,
      "end": 102,
      "text": "灯开关的声音，它原本听起来是这样的。"
    },
    {
      "start": 102.01,
      "end": 104.15,
      "text": "为了尝试这个声音，我把"
    },
    {
      "start": 104.15,
      "end": 106.1,
      "text": "它反转，降低了频率，"
    },
    {
      "start": 106.1,
      "end": 107.99,
      "text": "并添加了延迟，让它听起来像"
    },
    {
      "start": 107.99,
      "end": 112.179,
      "text": "这样。"
    },
    {
      "start": 112.189,
      "end": 115.729,
      "text": "然后我想添加一个类似"
    },
    {
      "start": 115.729,
      "end": 117.319,
      "text": "白噪声的音层来填充"
    },
    {
      "start": 117.319,
      "end": 119.479,
      "text": "频谱，所以我录制了滑动淋浴"
    },
    {
      "start": 119.479,
      "end": 127.79,
      "text": "门的声音。"
    },
    {
      "start": 127.8,
      "end": 130.539,
      "text": "我再次对这个声音使用了侧链，"
    },
    {
      "start": 130.539,
      "end": 132.34,
      "text": "它连接到了之前相同的Wish"
    },
    {
      "start": 132.34,
      "end": 133.9,
      "text": "效果器，但"
    },
    {
      "start": 133.9,
      "end": 136,
      "text": "位置略有不同。不过这次"
    },
    {
      "start": 136,
      "end": 137.98,
      "text": "侧链只影响"
    },
    {
      "start": 137.98,
      "end": 140.47,
      "text": "声音的增益。然后我添加了SoundToys的"
    },
    {
      "start": 140.47,
      "end": 143.94,
      "text": "Decapitator"
    },
    {
      "start": 143.95,
      "end": 158.23,
      "text": "和Deadlock插件。"
    },
    {
      "start": 158.24,
      "end": 162.53,
      "text": "我想再添加一个音层，因为我"
    },
    {
      "start": 162.53,
      "end": 163.97,
      "text": "觉得声音听起来还是"
    },
    {
      "start": 163.97,
      "end": 165.92,
      "text": "有点单薄，所以我用了一段在"
    },
    {
      "start": 165.92,
      "end": 167.99,
      "text": "鹅叫声上找到的录音，然后"
    },
    {
      "start": 167.99,
      "end": 169.97,
      "text": "使用TCE设置拉伸了这个音层，"
    },
    {
      "start": 169.97,
      "end": 172.85,
      "text": "并添加了合唱效果。"
    },
    {
      "start": 172.85,
      "end": 180.53,
      "text": "这就是它听起来的样子。"
    },
    {
      "start": 180.54,
      "end": 182.799,
      "text": "好的，这就是咒语这一部分"
    },
    {
      "start": 182.799,
      "end": 191,
      "text": "整体听起来的样子。"
    },
    {
      "start": 191.01,
      "end": 193.629,
      "text": "好的。 接下来，我专注于爆炸"
    },
    {
      "start": 193.629,
      "end": 195.31,
      "text": "音效部分。我先用"
    },
    {
      "start": 195.31,
      "end": 201.79,
      "text": "金属撞击声，然后加了一个均衡器来"
    },
    {
      "start": 201.79,
      "end": 203.829,
      "text": "削减低频并提升高频。"
    },
    {
      "start": 203.829,
      "end": 210.61,
      "text": "接着，我再次利用侧链来处理嗖"
    },
    {
      "start": 210.61,
      "end": 212.92,
      "text": "嗖声，这最终"
    },
    {
      "start": 212.92,
      "end": 215.11,
      "text": "影响了增益、频率偏移器"
    },
    {
      "start": 215.11,
      "end": 225.04,
      "text": "和均衡器的高频频段。"
    },
    {
      "start": 225.05,
      "end": 228.26,
      "text": "之后，我添加了Devil Lock插件，让"
    },
    {
      "start": 228.26,
      "end": 229.52,
      "text": "声音更有冲击力和"
    },
    {
      "start": 229.52,
      "end": 234.23,
      "text": "冲击力。在此基础上，我叠加了"
    },
    {
      "start": 234.23,
      "end": 236.18,
      "text": "纸张被碾碎的声音来模拟"
    },
    {
      "start": 236.18,
      "end": 241.16,
      "text": "火焰。我添加了"
    },
    {
      "start": 241.16,
      "end": 243.08,
      "text": "Decapitator插件，让它听起来"
    },
    {
      "start": 243.08,
      "end": 245.86,
      "text": "更有冲击力和侵略性，"
    },
    {
      "start": 245.86,
      "end": 249.52,
      "text": "然后又加了一些均衡器，去除了"
    },
    {
      "start": 249.52,
      "end": 253.24,
      "text": "低频的颤音。最后，"
    },
    {
      "start": 253.25,
      "end": 255.75,
      "text": "我 我"
    },
    {
      "start": 255.75,
      "end": 257.519,
      "text": "我 添加了壁炉点燃的声音，"
    },
    {
      "start": 257.519,
      "end": 261.11,
      "text": "以增强爆炸效果。这就是这部分最终的音效。"
    },
    {
      "start": 266.32,
      "end": 268.61,
      "text": "我想制作的最后一部分是"
    },
    {
      "start": 268.61,
      "end": 270.32,
      "text": "角色收集"
    },
    {
      "start": 270.32,
      "end": 272.54,
      "text": "散落在地上的物品的声音。为此，"
    },
    {
      "start": 272.54,
      "end": 274.07,
      "text": "我再次使用了Goose This插件，以及"
    },
    {
      "start": 274.07,
      "end": 278.419,
      "text": "我录制的"
    },
    {
      "start": 278.419,
      "end": 280.01,
      "text": "盖子弹开的声音（最初"
    },
    {
      "start": 280.01,
      "end": 283.54,
      "text": "听起来是这样的）。"
    },
    {
      "start": 283.55,
      "end": 286.819,
      "text": "然后，我反转了这些声音……"
    },
    {
      "start": 286.819,
      "end": 291.65,
      "text": "为了让声音听起来像这样，我提高了频率。"
    },
    {
      "start": 291.66,
      "end": 294.76,
      "text": "在此基础上，我录制了"
    },
    {
      "start": 294.76,
      "end": 296.77,
      "text": "灯泡闪烁的声音。最初"
    },
    {
      "start": 296.77,
      "end": 298.54,
      "text": "听起来太强烈了，所以我使用了"
    },
    {
      "start": 298.54,
      "end": 303.12,
      "text": "连接到马桶搋子声音的侧链。"
    },
    {
      "start": 303.13,
      "end": 305.08,
      "text": "我知道这听起来很奇怪，但它的"
    },
    {
      "start": 305.08,
      "end": 306.76,
      "text": "音色正是我想要的，所以用来模拟"
    },
    {
      "start": 306.76,
      "end": 308.62,
      "text": "闪烁的灯光效果非常完美。"
    },
    {
      "start": 308.62,
      "end": 311.86,
      "text": "我添加了频率偏移、延迟、均衡器和合唱效果器。"
    },
    {
      "start": 311.86,
      "end": 314.08,
      "text": "我们决定只调整"
    },
    {
      "start": 314.08,
      "end": 316.87,
      "text": "增益和均衡器的高频部分。这就是"
    },
    {
      "start": 316.87,
      "end": 323.03,
      "text": "这些效果器如何改变声音的。这"
    },
    {
      "start": 335.24,
      "end": 344.12,
      "text": "是这段小片段的合奏。"
    },
    {
      "start": 344.13,
      "end": 348.06,
      "text": "唯一剩下的声音是"
    },
    {
      "start": 348.07,
      "end": 350.56,
      "text": "咒语结束后留下的旋风声。为了录制这个声音，我用"
    },
    {
      "start": 350.56,
      "end": 353.11,
      "text": "NTG-2枪式麦克风轻轻地对着路边，"
    },
    {
      "start": 353.11,
      "end": 355.33,
      "text": "以获得尖锐的呼啸风声"
    },
    {
      "start": 355.33,
      "end": 365.89,
      "text": "效果。然后添加了频率偏移来"
    },
    {
      "start": 365.89,
      "end": 375.64,
      "text": "降低声音，均衡器来减少一些"
    },
    {
      "start": 375.64,
      "end": 384.7,
      "text": "共振频率，最后添加了两个"
    },
    {
      "start": 384.7,
      "end": 386.169,
      "text": "不同的延迟，让它听起来像"
    },
    {
      "start": 386.169,
      "end": 395.71,
      "text": "这样。最后，我在一些声音上"
    },
    {
      "start": 395.71,
      "end": 398.11,
      "text": "添加了混响效果。"
    },
    {
      "start": 398.11,
      "end": 399.82,
      "text": "我最终使用的混响插件是"
    },
    {
      "start": 399.82,
      "end": 402.94,
      "text": "Soundtoys 的 Little Plate。以上就是"
    },
    {
      "start": 402.94,
      "end": 404.47,
      "text": "我创作这首曲子所使用的所有声音。"
    },
    {
      "start": 404.47,
      "end": 417.72,
      "text": "我会再播放一遍，"
    },
    {
      "start": 417.73,
      "end": 419.96,
      "text": "非常感谢大家的观看，"
    },
    {
      "start": 419.96,
      "end": 421.43,
      "text": "希望你们喜欢这期声音"
    },
    {
      "start": 421.43,
      "end": 423.29,
      "text": "设计实验。如果你们"
    },
    {
      "start": 423.29,
      "end": 424.97,
      "text": "对这个系列有任何反馈或建议，"
    },
    {
      "start": 424.97,
      "end": 426.14,
      "text": "请在 请在"
    },
    {
      "start": 426.14,
      "end": 428.06,
      "text": "请在 下方评论区留言或在推特上给我发推文。"
    },
    {
      "start": 428.06,
      "end": 431.11,
      "text": "我们下期再见！"
    }
  ]
}
