{
  "videoId": "Oo3SRd_94VE",
  "language": "zh-CN",
  "source": "site-owned-from-public-captions",
  "reviewStatus": "draft",
  "updatedAt": "2026-08-17",
  "cues": [
    {
      "start": 15.065,
      "end": 26.39,
      "text": "【钟声】"
    },
    {
      "start": 26.4,
      "end": 30.12,
      "text": "哦。"
    },
    {
      "start": 46.8,
      "end": 53.7,
      "text": "【冲击声】"
    },
    {
      "start": 53.71,
      "end": 68.11,
      "text": "【音乐】"
    },
    {
      "start": 70.96,
      "end": 72.64,
      "text": "大家好，欢迎回到新一期"
    },
    {
      "start": 72.64,
      "end": 75.2,
      "text": "视频。今天我想分享"
    },
    {
      "start": 75.2,
      "end": 78.88,
      "text": "圣光魔法音效的制作拆解。"
    },
    {
      "start": 78.88,
      "end": 81.6,
      "text": "灵感来自我在"
    },
    {
      "start": 81.6,
      "end": 85.04,
      "text": "YouTube 上看到的 Jong Woo Jeong"
    },
    {
      "start": 85.04,
      "end": 87.92,
      "text": "精彩 VFX 作品集。非常感谢他"
    },
    {
      "start": 87.92,
      "end": 90.479,
      "text": "提供这么有启发性的画面，"
    },
    {
      "start": 90.479,
      "end": 93.6,
      "text": "让我为它设计声音。最终"
    },
    {
      "start": 93.6,
      "end": 101.516,
      "text": "效果是这样。"
    },
    {
      "start": 118.24,
      "end": 121.439,
      "text": "设计魔法音效时，首要思路是"
    },
    {
      "start": 121.439,
      "end": 122.96,
      "text": "一定要有某种"
    },
    {
      "start": 122.96,
      "end": 124.96,
      "text": "音调元素，同时还要"
    },
    {
      "start": 124.96,
      "end": 127.36,
      "text": "用某种噪声来承托"
    },
    {
      "start": 127.36,
      "end": 129.599,
      "text": "这种音调感。这次我重点"
    },
    {
      "start": 129.599,
      "end": 131.28,
      "text": "观察画面中的所有动态，"
    },
    {
      "start": 131.28,
      "end": 133.36,
      "text": "思考如何用"
    },
    {
      "start": 133.36,
      "end": 135.04,
      "text": "可录制、可处理的素材"
    },
    {
      "start": 135.04,
      "end": 137.28,
      "text": "呈现出来，并让它更"
    },
    {
      "start": 137.28,
      "end": 140.56,
      "text": "有趣。最后我选了很多"
    },
    {
      "start": 140.56,
      "end": 143.04,
      "text": "在家中找到的噪声纹理，"
    },
    {
      "start": 143.04,
      "end": 145.36,
      "text": "比如气泡膜、"
    },
    {
      "start": 145.36,
      "end": 147.52,
      "text": "气球、保鲜膜，以及"
    },
    {
      "start": 147.52,
      "end": 149.84,
      "text": "Costco 蛋白饮料外面的"
    },
    {
      "start": 149.84,
      "end": 151.36,
      "text": "塑料包装。我会寻找"
    },
    {
      "start": 151.36,
      "end": 153.28,
      "text": "那些把玩时能产生"
    },
    {
      "start": 153.28,
      "end": 154.8,
      "text": "有趣纹理的声音。"
    },
    {
      "start": 154.8,
      "end": 156.4,
      "text": "说到"
    },
    {
      "start": 156.4,
      "end": 158.72,
      "text": "音调元素，Kontakt 是"
    },
    {
      "start": 158.72,
      "end": 161.44,
      "text": "我最喜欢用来寻找"
    },
    {
      "start": 161.44,
      "end": 164.16,
      "text": "合成音调素材的工具之一。"
    },
    {
      "start": 164.16,
      "end": 165.92,
      "text": "我会加载一个音色，"
    },
    {
      "start": 165.92,
      "end": 176.186,
      "text": "随意试一试，"
    },
    {
      "start": 177.68,
      "end": 179.84,
      "text": "【音乐】从尾音中寻找"
    },
    {
      "start": 179.84,
      "end": 181.84,
      "text": "值得继续加工的"
    },
    {
      "start": 181.84,
      "end": 183.28,
      "text": "有趣部分。基本上，"
    },
    {
      "start": 183.28,
      "end": 185.12,
      "text": "我会用不同的"
    },
    {
      "start": 185.12,
      "end": 187.28,
      "text": "合成器反复这样做。这里是"
    },
    {
      "start": 187.28,
      "end": 191.12,
      "text": "ASHLIGHT，我也喜欢 HYPHA 和"
    },
    {
      "start": 191.12,
      "end": 195.182,
      "text": "Ethereal Earth。"
    },
    {
      "start": 205.2,
      "end": 207.36,
      "text": "可惜我没保留生成这个声音的"
    },
    {
      "start": 207.36,
      "end": 209.76,
      "text": "确切乐器和预设，"
    },
    {
      "start": 209.76,
      "end": 212,
      "text": "但其实确切的"
    },
    {
      "start": 212,
      "end": 214.08,
      "text": "旋钮或预设并不重要，"
    },
    {
      "start": 214.08,
      "end": 215.92,
      "text": "更重要的是跟随直觉。"
    },
    {
      "start": 215.92,
      "end": 218.72,
      "text": "接着我做了大量去噪处理，"
    },
    {
      "start": 218.72,
      "end": 220.959,
      "text": "尝试从中找出有趣的声音。"
    },
    {
      "start": 220.959,
      "end": 223.2,
      "text": "这里有混响和"
    },
    {
      "start": 223.2,
      "end": 225.92,
      "text": "限幅，限幅其实只是增益。然后是"
    },
    {
      "start": 225.92,
      "end": 228.72,
      "text": "MRatioMB 和 MVocoder。关键是"
    },
    {
      "start": 228.72,
      "end": 230.319,
      "text": "让它侧链回自身。"
    },
    {
      "start": 230.319,
      "end": 233.44,
      "text": "再用一次 MRatioMB，最后"
    },
    {
      "start": 233.44,
      "end": 236,
      "text": "限幅。快速 A/B 一下。"
    },
    {
      "start": 236,
      "end": 250.229,
      "text": "听一下。"
    },
    {
      "start": 250.239,
      "end": 252.319,
      "text": "挺有意思，几乎加入了"
    },
    {
      "start": 252.319,
      "end": 254.799,
      "text": "轻微的颤音效果，"
    },
    {
      "start": 254.799,
      "end": 256.639,
      "text": "让声音更有动态变化。甚至"
    },
    {
      "start": 256.639,
      "end": 258.239,
      "text": "只看波形，也能"
    },
    {
      "start": 258.239,
      "end": 260.639,
      "text": "看出其中的动态变化。"
    },
    {
      "start": 260.639,
      "end": 262.56,
      "text": "这个波形明显更有"
    },
    {
      "start": 262.56,
      "end": 264.88,
      "text": "起伏。需要注意，"
    },
    {
      "start": 264.88,
      "end": 267.6,
      "text": "如果大量使用 MVocoder 和"
    },
    {
      "start": 267.6,
      "end": 269.84,
      "text": "MRatioMB 处理声音，"
    },
    {
      "start": 269.84,
      "end": 271.6,
      "text": "往往会引入失真"
    },
    {
      "start": 271.6,
      "end": 274.24,
      "text": "和削波。"
    },
    {
      "start": 274.24,
      "end": 276,
      "text": "这里能明显听到。"
    },
    {
      "start": 276,
      "end": 278.16,
      "text": "RX 8 De-clip 用来"
    },
    {
      "start": 278.16,
      "end": 280.08,
      "text": "压住这些咔哒声，"
    },
    {
      "start": 280.08,
      "end": 282.308,
      "text": "让声音更干净。"
    },
    {
      "start": 282.308,
      "end": 283.51,
      "text": "【音乐】"
    },
    {
      "start": 283.52,
      "end": 285.759,
      "text": "【音乐】虽然仍有一点，"
    },
    {
      "start": 285.759,
      "end": 288.24,
      "text": "但只是可接受的粗粝感，"
    },
    {
      "start": 288.24,
      "end": 291.44,
      "text": "不会太刺耳。这就是其中一层。"
    },
    {
      "start": 291.44,
      "end": 293.28,
      "text": "继续之前，我最喜欢的"
    },
    {
      "start": 293.28,
      "end": 294.96,
      "text": "工作方式之一，是先制作"
    },
    {
      "start": 294.96,
      "end": 296.96,
      "text": "大量声音构件，"
    },
    {
      "start": 296.96,
      "end": 299.68,
      "text": "导出后，在"
    },
    {
      "start": 299.68,
      "end": 301.44,
      "text": "对画面设计时就有一套"
    },
    {
      "start": 301.44,
      "end": 303.12,
      "text": "大型声音库可随时调用，"
    },
    {
      "start": 303.12,
      "end": 304.25,
      "text": "后面就从中挑选。"
    },
    {
      "start": 358.944,
      "end": 363.27,
      "text": "【音乐】"
    },
    {
      "start": 363.28,
      "end": 397.749,
      "text": "【音乐】这里是更强烈的冲击层。"
    },
    {
      "start": 397.759,
      "end": 398.88,
      "text": "名字或许还能更好，"
    },
    {
      "start": 398.88,
      "end": 400.88,
      "text": "不过我当时只想快速完成。"
    },
    {
      "start": 400.88,
      "end": 402.479,
      "text": "下面说合唱。"
    },
    {
      "start": 402.479,
      "end": 404,
      "text": "合唱是这段视频中"
    },
    {
      "start": 404,
      "end": 406.319,
      "text": "较重要的部分，因为"
    },
    {
      "start": 406.319,
      "end": 408.16,
      "text": "这是圣光魔法，"
    },
    {
      "start": 408.16,
      "end": 411.36,
      "text": "还有某种范围治疗效果。"
    },
    {
      "start": 411.36,
      "end": 414.96,
      "text": "我喜欢的三款 VST 或 Kontakt 乐器中，"
    },
    {
      "start": 414.96,
      "end": 426.399,
      "text": "这一款叫 Choir Omnia。"
    },
    {
      "start": 434.319,
      "end": 436.319,
      "text": "我还发现七和弦"
    },
    {
      "start": 436.319,
      "end": 438.4,
      "text": "特别好用，尤其"
    },
    {
      "start": 438.4,
      "end": 440,
      "text": "配合 drop 2"
    },
    {
      "start": 440,
      "end": 442.08,
      "text": "排列，比如根音、"
    },
    {
      "start": 442.08,
      "end": 444.88,
      "text": "大七度，再加 3、5、9 音。"
    },
    {
      "start": 444.88,
      "end": 446.4,
      "text": "这样会让声音"
    },
    {
      "start": 446.4,
      "end": 448.16,
      "text": "非常开阔。也可以尝试"
    },
    {
      "start": 448.16,
      "end": 450.08,
      "text": "一些变化和弦，"
    },
    {
      "start": 450.08,
      "end": 452.08,
      "text": "比如降九、降十三，"
    },
    {
      "start": 452.08,
      "end": 454.24,
      "text": "比普通的"
    },
    {
      "start": 454.24,
      "end": 456.319,
      "text": "ii-V-I 进行"
    },
    {
      "start": 456.319,
      "end": 461.029,
      "text": "更有趣，对吧？"
    },
    {
      "start": 461.039,
      "end": 462.56,
      "text": "那样听起来很普通，"
    },
    {
      "start": 462.56,
      "end": 467.01,
      "text": "但你也可以这样。"
    },
    {
      "start": 487.039,
      "end": 488.96,
      "text": "处理方面，我通常不会"
    },
    {
      "start": 488.96,
      "end": 491.12,
      "text": "做太多，因为"
    },
    {
      "start": 491.12,
      "end": 493.28,
      "text": "这些采样进入采样器前"
    },
    {
      "start": 493.28,
      "end": 494.96,
      "text": "已经母带处理过，"
    },
    {
      "start": 494.96,
      "end": 496.72,
      "text": "而且输出里已经带有"
    },
    {
      "start": 496.72,
      "end": 499.36,
      "text": "这款 VST 自带的混响。"
    },
    {
      "start": 499.36,
      "end": 501.28,
      "text": "没坏就不用修。VOXOS 是"
    },
    {
      "start": 501.28,
      "end": 503.7,
      "text": "我找到的另一款 Kontakt 乐器。"
    },
    {
      "start": 503.7,
      "end": 510.71,
      "text": "【人声吟唱】"
    },
    {
      "start": 510.72,
      "end": 512.8,
      "text": "下一款合成器"
    },
    {
      "start": 512.8,
      "end": 514.959,
      "text": "叫 HYPHA，预设名为"
    },
    {
      "start": 514.959,
      "end": 516.56,
      "text": "Epiphany。我喜欢它，是因为"
    },
    {
      "start": 516.56,
      "end": 520.32,
      "text": "它听起来不完全像"
    },
    {
      "start": 520.32,
      "end": 522.24,
      "text": "真实合唱录音，"
    },
    {
      "start": 522.24,
      "end": 523.519,
      "text": "而是带有一点"
    },
    {
      "start": 523.519,
      "end": 525.839,
      "text": "模糊性。你很难判断它"
    },
    {
      "start": 525.839,
      "end": 528.32,
      "text": "来自合成引擎，还是"
    },
    {
      "start": 528.32,
      "end": 530.88,
      "text": "合唱与合成引擎的混合。"
    },
    {
      "start": 530.88,
      "end": 536.441,
      "text": "来听一下。"
    },
    {
      "start": 544,
      "end": 546,
      "text": "合成器部分基本就是这些。"
    },
    {
      "start": 546,
      "end": 548.64,
      "text": "主要是先做出许多铺底"
    },
    {
      "start": 548.64,
      "end": 550.56,
      "text": "素材供后续使用。"
    },
    {
      "start": 550.56,
      "end": 553.6,
      "text": "作为补充，我还录了"
    },
    {
      "start": 553.6,
      "end": 557.6,
      "text": "两样东西：一个是颂钵，"
    },
    {
      "start": 557.6,
      "end": 559.839,
      "text": "另一个是圣诞"
    },
    {
      "start": 559.839,
      "end": 569.269,
      "text": "铃铛。先听原始录音。"
    },
    {
      "start": 569.279,
      "end": 571.36,
      "text": "这里想让它更"
    },
    {
      "start": 571.36,
      "end": 572.88,
      "text": "厚实一点。这三个插件"
    },
    {
      "start": 572.88,
      "end": 575.6,
      "text": "大家可能已在我的很多视频"
    },
    {
      "start": 575.6,
      "end": 578.16,
      "text": "和作品里见过。"
    },
    {
      "start": 578.16,
      "end": 581.519,
      "text": "EchoBoy 用的是 Empty Tanker"
    },
    {
      "start": 581.519,
      "end": 584.32,
      "text": "预设，最后是 Altiverb 的"
    },
    {
      "start": 584.32,
      "end": 588.71,
      "text": "Festhalle 脉冲响应。"
    },
    {
      "start": 588.72,
      "end": 590.64,
      "text": "接着再加一些"
    },
    {
      "start": 590.64,
      "end": 592.88,
      "text": "Tremolator 和滤波，"
    },
    {
      "start": 592.88,
      "end": 599.19,
      "text": "让声音更有趣。"
    },
    {
      "start": 599.2,
      "end": 601.12,
      "text": "使用 Tremolator 时，我通常会"
    },
    {
      "start": 601.12,
      "end": 603.04,
      "text": "略微调整 Rate Mod"
    },
    {
      "start": 603.04,
      "end": 604.959,
      "text": "和 Depth Mod。这里是在"
    },
    {
      "start": 604.959,
      "end": 607.76,
      "text": "制作一些掠过声，用的是"
    },
    {
      "start": 607.76,
      "end": 613.03,
      "text": "SpinTracer。"
    },
    {
      "start": 613.04,
      "end": 615.279,
      "text": "这一条好像经过 Reaktor。"
    },
    {
      "start": 615.279,
      "end": 617.04,
      "text": "我的做法是把声音放进来，"
    },
    {
      "start": 617.04,
      "end": 619.6,
      "text": "然后这样处理。"
    },
    {
      "start": 619.6,
      "end": 621.839,
      "text": "你应该明白了。"
    },
    {
      "start": 621.839,
      "end": 625.532,
      "text": "最后还有这个。"
    },
    {
      "start": 625.532,
      "end": 630.069,
      "text": "【音乐】"
    },
    {
      "start": 630.079,
      "end": 632.24,
      "text": "我这里没有保留预设，"
    },
    {
      "start": 632.24,
      "end": 634.56,
      "text": "插件是 Unfiltered Audio 的 Silo。"
    },
    {
      "start": 634.56,
      "end": 636.72,
      "text": "这台机器没有激活它，"
    },
    {
      "start": 636.72,
      "end": 638.48,
      "text": "但它有很多很酷的预设，"
    },
    {
      "start": 638.48,
      "end": 640.64,
      "text": "能显著丰富"
    },
    {
      "start": 640.64,
      "end": 643.67,
      "text": "尾音。"
    },
    {
      "start": 643.68,
      "end": 645.36,
      "text": "可以看到部分颗粒"
    },
    {
      "start": 645.36,
      "end": 647.68,
      "text": "被反转，上面还叠了延迟，"
    },
    {
      "start": 647.68,
      "end": 649.04,
      "text": "于是结尾会形成"
    },
    {
      "start": 649.04,
      "end": 651.68,
      "text": "很有趣的尾音。"
    },
    {
      "start": 651.68,
      "end": 652.959,
      "text": "仅凭颂钵，就能得到"
    },
    {
      "start": 652.959,
      "end": 655.04,
      "text": "许多好素材。"
    },
    {
      "start": 655.04,
      "end": 658.282,
      "text": "接下来是圣诞铃铛。"
    },
    {
      "start": 658.282,
      "end": 661.59,
      "text": "【铃声】"
    },
    {
      "start": 661.6,
      "end": 663.68,
      "text": "照例先用这三个插件"
    },
    {
      "start": 663.68,
      "end": 665.92,
      "text": "补充低频与厚度。"
    },
    {
      "start": 665.92,
      "end": 669.6,
      "text": "再用 EQ 削掉低频"
    },
    {
      "start": 669.6,
      "end": 672.64,
      "text": "和隆隆声，再用 Portal"
    },
    {
      "start": 672.64,
      "end": 676.399,
      "text": "制造下坠移调，接 MRatioMB"
    },
    {
      "start": 676.399,
      "end": 682.71,
      "text": "和混响。"
    },
    {
      "start": 682.72,
      "end": 684.56,
      "text": "我又做了一轮，把它"
    },
    {
      "start": 684.56,
      "end": 688.412,
      "text": "大幅降调到 0.3 倍速。"
    },
    {
      "start": 688.412,
      "end": 691.03,
      "text": "【铃声】"
    },
    {
      "start": 691.04,
      "end": 693.12,
      "text": "这些处理基本都在提取"
    },
    {
      "start": 693.12,
      "end": 695.6,
      "text": "其中的音调感。"
    },
    {
      "start": 695.6,
      "end": 697.76,
      "text": "Z-Noise 与 MRatioMB 类似，"
    },
    {
      "start": 697.76,
      "end": 701.04,
      "text": "还有 entropyEQ+。接着用 EQ"
    },
    {
      "start": 701.04,
      "end": 704.959,
      "text": "削去超高频，再加 R-Bass 和 H3000，"
    },
    {
      "start": 704.959,
      "end": 707.839,
      "text": "随后是 Radiator。这里推得较重，"
    },
    {
      "start": 707.839,
      "end": 710.079,
      "text": "因为最近我想给声音"
    },
    {
      "start": 710.079,
      "end": 712.16,
      "text": "加一点粗粝感。"
    },
    {
      "start": 712.16,
      "end": 713.92,
      "text": "再加少量 Uhbik-G，"
    },
    {
      "start": 713.92,
      "end": 716.399,
      "text": "它像是音高调制器。"
    },
    {
      "start": 716.399,
      "end": 723.829,
      "text": "旋钮只要稍微偏离中心，"
    },
    {
      "start": 723.839,
      "end": 726.079,
      "text": "就像一个失谐旋钮。"
    },
    {
      "start": 726.079,
      "end": 729.2,
      "text": "再用 MRatioMB，最后加一点"
    },
    {
      "start": 729.2,
      "end": 731.12,
      "text": "Soothe2，压住"
    },
    {
      "start": 731.12,
      "end": 737.03,
      "text": "刺耳感。"
    },
    {
      "start": 737.04,
      "end": 738.16,
      "text": "这些纹理很有意思。"
    },
    {
      "start": 738.16,
      "end": 739.76,
      "text": "我确实用了"
    },
    {
      "start": 739.76,
      "end": 749.19,
      "text": "不少这一组声音构件。"
    },
    {
      "start": 749.2,
      "end": 751.36,
      "text": "这里还有四条"
    },
    {
      "start": 751.36,
      "end": 754.399,
      "text": "经不同 Crystallizer 预设处理的铃铛。"
    },
    {
      "start": 754.399,
      "end": 756.079,
      "text": "当时我还不确定目标，"
    },
    {
      "start": 756.079,
      "end": 757.68,
      "text": "所以就让它们"
    },
    {
      "start": 757.68,
      "end": 758.72,
      "text": "分别经过四种预设，"
    },
    {
      "start": 758.72,
      "end": 760.72,
      "text": "录下输出，最后得到"
    },
    {
      "start": 760.72,
      "end": 768.313,
      "text": "这些结果。"
    },
    {
      "start": 768.323,
      "end": 778.71,
      "text": "【铃声】"
    },
    {
      "start": 778.72,
      "end": 780.32,
      "text": "接下来是气泡膜"
    },
    {
      "start": 780.32,
      "end": 786.31,
      "text": "录音。"
    },
    {
      "start": 786.32,
      "end": 789.68,
      "text": "效果链先做清理，"
    },
    {
      "start": 789.68,
      "end": 793.44,
      "text": "再压缩并加少量失真。"
    },
    {
      "start": 793.44,
      "end": 795.6,
      "text": "这一项实际上是在"
    },
    {
      "start": 795.6,
      "end": 798.949,
      "text": "强化噪声。"
    },
    {
      "start": 798.959,
      "end": 800.8,
      "text": "渲染出来后，再经过"
    },
    {
      "start": 800.8,
      "end": 808.87,
      "text": "一长串插件。"
    },
    {
      "start": 808.88,
      "end": 810.32,
      "text": "处理前后差异很大。"
    },
    {
      "start": 810.32,
      "end": 811.519,
      "text": "下面逐个来看。"
    },
    {
      "start": 811.519,
      "end": 814.24,
      "text": "值得重点关注的"
    },
    {
      "start": 814.24,
      "end": 817.2,
      "text": "首先是 PhaseMistress，"
    },
    {
      "start": 817.2,
      "end": 825.99,
      "text": "这里的设置非常快。"
    },
    {
      "start": 826,
      "end": 830.079,
      "text": "然后是 kHs Dynamics。"
    },
    {
      "start": 830.079,
      "end": 832.88,
      "text": "它本质上是"
    },
    {
      "start": 832.88,
      "end": 834.72,
      "text": "向上扩展器。"
    },
    {
      "start": 834.72,
      "end": 837.44,
      "text": "低于阈值的声音"
    },
    {
      "start": 837.44,
      "end": 839.6,
      "text": "会被压低，"
    },
    {
      "start": 839.6,
      "end": 841.519,
      "text": "而高于阈值的声音"
    },
    {
      "start": 841.519,
      "end": 844.24,
      "text": "会被抬高。"
    },
    {
      "start": 844.24,
      "end": 845.76,
      "text": "我想保留其中很酷的"
    },
    {
      "start": 845.76,
      "end": 847.12,
      "text": "动态变化，但底部"
    },
    {
      "start": 847.12,
      "end": 849.04,
      "text": "仍藏着一点原始录音"
    },
    {
      "start": 849.04,
      "end": 850.88,
      "text": "的声音，音量很低。"
    },
    {
      "start": 850.88,
      "end": 852.639,
      "text": "所以我尽量"
    },
    {
      "start": 852.639,
      "end": 859.03,
      "text": "把它清掉。"
    },
    {
      "start": 859.04,
      "end": 861.199,
      "text": "现在干净多了，只剩"
    },
    {
      "start": 861.199,
      "end": 863.839,
      "text": "一点点底层声音。"
    },
    {
      "start": 863.839,
      "end": 865.76,
      "text": "处理得相当激进。"
    },
    {
      "start": 865.76,
      "end": 867.44,
      "text": "接着得到一整层声音，再"
    },
    {
      "start": 867.44,
      "end": 873.75,
      "text": "做成几条掠过声。"
    },
    {
      "start": 873.76,
      "end": 875.12,
      "text": "最终的掠过声"
    },
    {
      "start": 875.12,
      "end": 882.389,
      "text": "大致是这样。"
    },
    {
      "start": 882.399,
      "end": 884,
      "text": "我很喜欢掠过动作之前"
    },
    {
      "start": 884,
      "end": 887.92,
      "text": "的那些素材，"
    },
    {
      "start": 887.92,
      "end": 890.32,
      "text": "比如这种。于是用"
    },
    {
      "start": 890.32,
      "end": 892.24,
      "text": "Little Radiator 加了大量饱和。"
    },
    {
      "start": 892.24,
      "end": 894.079,
      "text": "再切掉一些低频，"
    },
    {
      "start": 894.079,
      "end": 896,
      "text": "最后用滤波增加"
    },
    {
      "start": 896,
      "end": 899.315,
      "text": "动态变化。"
    },
    {
      "start": 899.325,
      "end": 909.269,
      "text": "【尖锐音效】"
    },
    {
      "start": 909.279,
      "end": 911.12,
      "text": "我也多次用了这个声音，"
    },
    {
      "start": 911.12,
      "end": 913.839,
      "text": "尤其是在"
    },
    {
      "start": 913.839,
      "end": 919.189,
      "text": "主爆发前的引入段，"
    },
    {
      "start": 919.199,
      "end": 921.04,
      "text": "还用它"
    },
    {
      "start": 921.04,
      "end": 923.92,
      "text": "覆盖法球上升时"
    },
    {
      "start": 923.92,
      "end": 930.629,
      "text": "弯曲摆动的尾迹。"
    },
    {
      "start": 930.639,
      "end": 936.47,
      "text": "接下来是气球。"
    },
    {
      "start": 936.48,
      "end": 938.639,
      "text": "它或许适合用作"
    },
    {
      "start": 938.639,
      "end": 940.8,
      "text": "爆发前的引入。效果链"
    },
    {
      "start": 940.8,
      "end": 945.509,
      "text": "打开后是这样。"
    },
    {
      "start": 945.519,
      "end": 946.88,
      "text": "核心目标仍是增加"
    },
    {
      "start": 946.88,
      "end": 948.639,
      "text": "动态变化。这里有"
    },
    {
      "start": 948.639,
      "end": 952,
      "text": "压缩、FilterFreak、"
    },
    {
      "start": 952,
      "end": 954.88,
      "text": "失真、饱和与振幅调制。"
    },
    {
      "start": 954.88,
      "end": 956.88,
      "text": "这里同样调整 Rate Mod 和"
    },
    {
      "start": 956.88,
      "end": 960.32,
      "text": "Depth Mod，再用 FilterFreak、"
    },
    {
      "start": 960.32,
      "end": 963.199,
      "text": "MHarmonizer、Entropy，最后"
    },
    {
      "start": 963.199,
      "end": 970.31,
      "text": "加混响。听起来是这样。"
    },
    {
      "start": 970.32,
      "end": 972.079,
      "text": "关键是让它"
    },
    {
      "start": 972.079,
      "end": 973.92,
      "text": "更难辨认。回到前面的"
    },
    {
      "start": 973.92,
      "end": 975.92,
      "text": "设计思路，这些"
    },
    {
      "start": 975.92,
      "end": 978.079,
      "text": "录音素材都能加入"
    },
    {
      "start": 978.079,
      "end": 980.399,
      "text": "大量动态变化，放在"
    },
    {
      "start": 980.399,
      "end": 982.399,
      "text": "音调元素下方，让声音"
    },
    {
      "start": 982.399,
      "end": 984,
      "text": "落在真实空间里。保鲜膜也一样。"
    },
    {
      "start": 984,
      "end": 988.79,
      "text": "听一下。"
    },
    {
      "start": 988.8,
      "end": 990.959,
      "text": "Crystallizer 的音高设为"
    },
    {
      "start": 990.959,
      "end": 994.079,
      "text": "低一个八度，延迟 200 毫秒，"
    },
    {
      "start": 994.079,
      "end": 999.749,
      "text": "Splice 为 98 毫秒。"
    },
    {
      "start": 999.759,
      "end": 1001.519,
      "text": "接着我想做一些冲击层。"
    },
    {
      "start": 1001.519,
      "end": 1003.12,
      "text": "前几期视频里可能见过，"
    },
    {
      "start": 1003.12,
      "end": 1005.04,
      "text": "我主要使用"
    },
    {
      "start": 1005.04,
      "end": 1006.959,
      "text": "Enforcer 和 Reaktor 的 Whoosh。"
    },
    {
      "start": 1006.959,
      "end": 1008.72,
      "text": "把这个参数拉到最左，"
    },
    {
      "start": 1008.72,
      "end": 1016.069,
      "text": "就能做出冲击层。"
    },
    {
      "start": 1016.079,
      "end": 1017.759,
      "text": "思路和之前的水晶法术一样。"
    },
    {
      "start": 1017.759,
      "end": 1020.639,
      "text": "下方三条轨道"
    },
    {
      "start": 1020.639,
      "end": 1022.32,
      "text": "分别使用三个不同的"
    },
    {
      "start": 1022.32,
      "end": 1025.039,
      "text": "Portal 预设。还有滤波、"
    },
    {
      "start": 1025.039,
      "end": 1028.559,
      "text": "Crystallizer、镶边，"
    },
    {
      "start": 1028.559,
      "end": 1030.4,
      "text": "以及 Enforcer。这里用了"
    },
    {
      "start": 1030.4,
      "end": 1032.64,
      "text": "Explosion High Body 预设，"
    },
    {
      "start": 1032.64,
      "end": 1039.429,
      "text": "叠入真正的底鼓冲击。"
    },
    {
      "start": 1039.439,
      "end": 1041.199,
      "text": "这里也一样，仍是"
    },
    {
      "start": 1041.199,
      "end": 1043.52,
      "text": "塑料包装的同一份源素材，"
    },
    {
      "start": 1043.52,
      "end": 1045.199,
      "text": "但做成了掠过声，"
    },
    {
      "start": 1045.199,
      "end": 1050.07,
      "text": "而不是冲击层。"
    },
    {
      "start": 1050.08,
      "end": 1052.24,
      "text": "这里加一点 Crystallizer，"
    },
    {
      "start": 1052.24,
      "end": 1054.08,
      "text": "填补送入"
    },
    {
      "start": 1054.08,
      "end": 1060.39,
      "text": "Whoosh 前的空隙。"
    },
    {
      "start": 1060.4,
      "end": 1076.95,
      "text": "再用 FilterFreak 和 PhaseMistress。"
    },
    {
      "start": 1076.96,
      "end": 1081.36,
      "text": "最后是气泡膜。"
    },
    {
      "start": 1081.36,
      "end": 1084.08,
      "text": "先清理，再用 Tremolator 做"
    },
    {
      "start": 1084.08,
      "end": 1087.039,
      "text": "振幅调制，并调节 Depth。"
    },
    {
      "start": 1087.039,
      "end": 1093.909,
      "text": "接着用 SpinTracer 试着调整。"
    },
    {
      "start": 1093.919,
      "end": 1099.59,
      "text": "但我还想要更多动态变化。"
    },
    {
      "start": 1099.6,
      "end": 1104.32,
      "text": "于是加 EQ、EchoBoy 延迟，"
    },
    {
      "start": 1104.32,
      "end": 1106.88,
      "text": "以及向上压缩。"
    },
    {
      "start": 1106.88,
      "end": 1114.71,
      "text": "我也用保鲜膜做了几条冲击层。"
    },
    {
      "start": 1114.72,
      "end": 1116.08,
      "text": "以上就是这次重设计所需"
    },
    {
      "start": 1116.08,
      "end": 1118.16,
      "text": "各种声音构件的"
    },
    {
      "start": 1118.16,
      "end": 1120.88,
      "text": "制作过程。接下来进入"
    },
    {
      "start": 1120.88,
      "end": 1127.912,
      "text": "正式的画面对位设计。"
    },
    {
      "start": 1127.922,
      "end": 1132.71,
      "text": "【音乐】"
    },
    {
      "start": 1132.72,
      "end": 1134,
      "text": "我把它拆成"
    },
    {
      "start": 1134,
      "end": 1140.07,
      "text": "四个部分。"
    },
    {
      "start": 1140.08,
      "end": 1142.16,
      "text": "这一段完全靠剪辑完成。"
    },
    {
      "start": 1142.16,
      "end": 1148.07,
      "text": "素材来自气泡膜。"
    },
    {
      "start": 1148.08,
      "end": 1150.24,
      "text": "我觉得它很好地覆盖了"
    },
    {
      "start": 1150.24,
      "end": 1152.799,
      "text": "法杖旋转的动作。"
    },
    {
      "start": 1152.799,
      "end": 1155.2,
      "text": "接着这一段是"
    },
    {
      "start": 1155.2,
      "end": 1158,
      "text": "法球在眼前爆发前的"
    },
    {
      "start": 1158,
      "end": 1161.2,
      "text": "引入。这里使用的元素"
    },
    {
      "start": 1161.2,
      "end": 1165.039,
      "text": "包括铃铛和噪声，"
    },
    {
      "start": 1165.039,
      "end": 1167.28,
      "text": "还有蛋白饮料的"
    },
    {
      "start": 1167.28,
      "end": 1171.2,
      "text": "塑料包装，并大幅升调。"
    },
    {
      "start": 1171.2,
      "end": 1173.12,
      "text": "再用少量铃铛"
    },
    {
      "start": 1173.12,
      "end": 1175.6,
      "text": "提供音调感。最后，"
    },
    {
      "start": 1175.6,
      "end": 1177.76,
      "text": "还有一条普通的"
    },
    {
      "start": 1177.76,
      "end": 1180,
      "text": "敲击颂钵声；我发现"
    },
    {
      "start": 1180,
      "end": 1182.48,
      "text": "把它反转后"
    },
    {
      "start": 1182.48,
      "end": 1185.28,
      "text": "很适合做引入。合在"
    },
    {
      "start": 1185.28,
      "end": 1187.52,
      "text": "一起是这样。"
    },
    {
      "start": 1187.52,
      "end": 1190.96,
      "text": "接着是冲击本体："
    },
    {
      "start": 1190.96,
      "end": 1192.88,
      "text": "先用塑料包装做出的"
    },
    {
      "start": 1192.88,
      "end": 1194.88,
      "text": "失真声音，"
    },
    {
      "start": 1194.88,
      "end": 1197.679,
      "text": "再叠一层颂钵。"
    },
    {
      "start": 1197.679,
      "end": 1200.48,
      "text": "还有经过降噪、"
    },
    {
      "start": 1200.48,
      "end": 1204.47,
      "text": "大幅升调的铃铛，"
    },
    {
      "start": 1204.48,
      "end": 1206.72,
      "text": "用于补充"
    },
    {
      "start": 1206.72,
      "end": 1211.59,
      "text": "低音区的音调感。"
    },
    {
      "start": 1211.6,
      "end": 1213.6,
      "text": "这两层用来表现"
    },
    {
      "start": 1213.6,
      "end": 1215.2,
      "text": "法球缩回去的过程。"
    },
    {
      "start": 1215.2,
      "end": 1218.08,
      "text": "我很想捕捉星星"
    },
    {
      "start": 1218.08,
      "end": 1219.679,
      "text": "沿星座移动的感觉，"
    },
    {
      "start": 1219.679,
      "end": 1221.28,
      "text": "画面里大概是"
    },
    {
      "start": 1221.28,
      "end": 1223.679,
      "text": "“噗、噗、噗”这样的节奏。"
    },
    {
      "start": 1223.679,
      "end": 1225.52,
      "text": "于是把铃铛"
    },
    {
      "start": 1225.52,
      "end": 1227.52,
      "text": "反转，再手绘"
    },
    {
      "start": 1227.52,
      "end": 1229.2,
      "text": "Tremolator 自动化。"
    },
    {
      "start": 1229.2,
      "end": 1232.069,
      "text": "这一层就是气泡膜。"
    },
    {
      "start": 1232.069,
      "end": 1233.679,
      "text": "【铃声】"
    },
    {
      "start": 1233.679,
      "end": 1235.6,
      "text": "可以发现，"
    },
    {
      "start": 1235.6,
      "end": 1237.679,
      "text": "音调元素与"
    },
    {
      "start": 1237.679,
      "end": 1243.35,
      "text": "物理质感几乎各占一半。"
    },
    {
      "start": 1243.36,
      "end": 1245.919,
      "text": "第二部分。【气球喷气声】"
    },
    {
      "start": 1245.919,
      "end": 1248.48,
      "text": "这里法球被射向"
    },
    {
      "start": 1248.48,
      "end": 1251.039,
      "text": "天空。【气球喷气声】先用气球"
    },
    {
      "start": 1251.039,
      "end": 1254,
      "text": "作为引入，再用气泡膜冲击"
    },
    {
      "start": 1254,
      "end": 1257.12,
      "text": "表现尾迹。"
    },
    {
      "start": 1257.12,
      "end": 1261.12,
      "text": "还加了几条掠过声，"
    },
    {
      "start": 1261.12,
      "end": 1264.96,
      "text": "强化法球射出的动作。"
    },
    {
      "start": 1264.96,
      "end": 1267.12,
      "text": "这里再增加一点音调感。"
    },
    {
      "start": 1267.12,
      "end": 1268.88,
      "text": "本质上就是剪辑"
    },
    {
      "start": 1268.88,
      "end": 1270.64,
      "text": "我们做好的所有源素材，"
    },
    {
      "start": 1270.64,
      "end": 1272.96,
      "text": "确保它们贴合画面。"
    },
    {
      "start": 1272.96,
      "end": 1275.6,
      "text": "最后是爆发本身。"
    },
    {
      "start": 1275.6,
      "end": 1277.2,
      "text": "引入段用了许多立体声"
    },
    {
      "start": 1277.2,
      "end": 1281.039,
      "text": "素材。独奏时，"
    },
    {
      "start": 1281.039,
      "end": 1282.88,
      "text": "与单声道相比差异很大。"
    },
    {
      "start": 1282.88,
      "end": 1285.039,
      "text": "立体声让它更"
    },
    {
      "start": 1285.039,
      "end": 1286.88,
      "text": "开阔，但也要避免"
    },
    {
      "start": 1286.88,
      "end": 1289.36,
      "text": "所有声音都做成立体声，"
    },
    {
      "start": 1289.36,
      "end": 1290.799,
      "text": "否则"
    },
    {
      "start": 1290.799,
      "end": 1292.96,
      "text": "自然就没有元素能突出。"
    },
    {
      "start": 1292.96,
      "end": 1294.48,
      "text": "引入段其实用了"
    },
    {
      "start": 1294.48,
      "end": 1297.039,
      "text": "气球。"
    },
    {
      "start": 1297.039,
      "end": 1298.4,
      "text": "它的音调感很有意思，"
    },
    {
      "start": 1298.4,
      "end": 1300.4,
      "text": "放进去后"
    },
    {
      "start": 1300.4,
      "end": 1304.63,
      "text": "效果正合适。"
    },
    {
      "start": 1304.64,
      "end": 1306.96,
      "text": "冲击本体很简单，"
    },
    {
      "start": 1306.96,
      "end": 1311.27,
      "text": "只有这三层。"
    },
    {
      "start": 1311.28,
      "end": 1313.039,
      "text": "保鲜膜制作的硬冲击层，"
    },
    {
      "start": 1313.039,
      "end": 1314.799,
      "text": "颂钵层，以及"
    },
    {
      "start": 1314.799,
      "end": 1318.53,
      "text": "塑料包装制作的冲击层。"
    },
    {
      "start": 1318.53,
      "end": 1323.105,
      "text": "【人声吟唱】"
    },
    {
      "start": 1327.039,
      "end": 1333.029,
      "text": "这些都是合唱层。"
    },
    {
      "start": 1333.039,
      "end": 1334.159,
      "text": "我尽量考虑"
    },
    {
      "start": 1334.159,
      "end": 1336.24,
      "text": "频率分布。比如"
    },
    {
      "start": 1336.24,
      "end": 1337.6,
      "text": "有低音区"
    },
    {
      "start": 1337.6,
      "end": 1340.4,
      "text": "合唱、高音区合唱，"
    },
    {
      "start": 1340.4,
      "end": 1347.51,
      "text": "以及极高音区的铃铛。"
    },
    {
      "start": 1347.52,
      "end": 1349.84,
      "text": "还有一条画得很粗糙的"
    },
    {
      "start": 1349.84,
      "end": 1351.84,
      "text": "Tremolator 自动化，尝试捕捉"
    },
    {
      "start": 1351.84,
      "end": 1355.27,
      "text": "动态变化。"
    },
    {
      "start": 1355.28,
      "end": 1357.6,
      "text": "颂钵经过 Silo"
    },
    {
      "start": 1357.6,
      "end": 1359.52,
      "text": "颗粒混响，形成"
    },
    {
      "start": 1359.52,
      "end": 1364.39,
      "text": "有趣的尾音。"
    },
    {
      "start": 1364.4,
      "end": 1367.919,
      "text": "再加一些铃铛，"
    },
    {
      "start": 1367.919,
      "end": 1370.24,
      "text": "以及低频支撑，因为它在我听来"
    },
    {
      "start": 1370.24,
      "end": 1372.559,
      "text": "像冲击波的尾音"
    },
    {
      "start": 1372.559,
      "end": 1375.919,
      "text": "向周围扩散。"
    },
    {
      "start": 1375.919,
      "end": 1380.745,
      "text": "再加合唱。合起来是这样。"
    },
    {
      "start": 1385.52,
      "end": 1388.4,
      "text": "最后，星星落到"
    },
    {
      "start": 1388.4,
      "end": 1389.84,
      "text": "队友身上并"
    },
    {
      "start": 1389.84,
      "end": 1393.909,
      "text": "为他们治疗。"
    },
    {
      "start": 1393.919,
      "end": 1396,
      "text": "我用一些素材"
    },
    {
      "start": 1396,
      "end": 1397.919,
      "text": "覆盖这些动作。它们在混音中"
    },
    {
      "start": 1397.919,
      "end": 1399.36,
      "text": "有点被淹没，"
    },
    {
      "start": 1399.36,
      "end": 1405.51,
      "text": "但作用只是补足画面。"
    },
    {
      "start": 1405.52,
      "end": 1407.36,
      "text": "这是前面做的不同冲击层，"
    },
    {
      "start": 1407.36,
      "end": 1411.679,
      "text": "再叠加经过 Silo 的颂钵。"
    },
    {
      "start": 1411.679,
      "end": 1413.84,
      "text": "最后是结尾"
    },
    {
      "start": 1413.84,
      "end": 1415.679,
      "text": "法术淡出、"
    },
    {
      "start": 1415.679,
      "end": 1417.6,
      "text": "结束的部分。基本上"
    },
    {
      "start": 1417.6,
      "end": 1425.909,
      "text": "都是反转声音。"
    },
    {
      "start": 1425.919,
      "end": 1427.679,
      "text": "就是这样。"
    },
    {
      "start": 1427.679,
      "end": 1429.28,
      "text": "我还加了一点"
    },
    {
      "start": 1429.28,
      "end": 1431.36,
      "text": "圣诞铃铛，让它"
    },
    {
      "start": 1431.36,
      "end": 1433.2,
      "text": "逐渐淡出，因为此前"
    },
    {
      "start": 1433.2,
      "end": 1437.039,
      "text": "主要听到的只有"
    },
    {
      "start": 1437.039,
      "end": 1438.64,
      "text": "主体层。我觉得用"
    },
    {
      "start": 1438.64,
      "end": 1441.039,
      "text": "这样一层音调感收尾很有意思，"
    },
    {
      "start": 1441.039,
      "end": 1448.211,
      "text": "也就是合唱。"
    },
    {
      "start": 1448.221,
      "end": 1452.789,
      "text": "【音乐】"
    },
    {
      "start": 1452.799,
      "end": 1455.2,
      "text": "另外玩一下，这是我"
    },
    {
      "start": 1455.2,
      "end": 1457.6,
      "text": "很快做出的另一版变化，"
    },
    {
      "start": 1457.6,
      "end": 1459.76,
      "text": "大概只花两秒。我的做法"
    },
    {
      "start": 1459.76,
      "end": 1462.799,
      "text": "是打开 REAPER 脚本 MC_Variation_Generator，"
    },
    {
      "start": 1462.799,
      "end": 1466.159,
      "text": "点击随机化。"
    },
    {
      "start": 1466.159,
      "end": 1467.6,
      "text": "一般来说，"
    },
    {
      "start": 1467.6,
      "end": 1469.36,
      "text": "它会随机改变"
    },
    {
      "start": 1469.36,
      "end": 1471.44,
      "text": "每个媒体项的多个参数，"
    },
    {
      "start": 1471.44,
      "end": 1473.2,
      "text": "所以结果通常"
    },
    {
      "start": 1473.2,
      "end": 1475.039,
      "text": "需要大量剪辑才能"
    },
    {
      "start": 1475.039,
      "end": 1477.76,
      "text": "达到可交付水平。但这次"
    },
    {
      "start": 1477.76,
      "end": 1479.6,
      "text": "我只点了一次，"
    },
    {
      "start": 1479.6,
      "end": 1481.44,
      "text": "听起来就不错，于是"
    },
    {
      "start": 1481.44,
      "end": 1489.477,
      "text": "保留下来。"
    },
    {
      "start": 1491.76,
      "end": 1493.2,
      "text": "今天基本就是这些。"
    },
    {
      "start": 1493.2,
      "end": 1495.52,
      "text": "为这段精彩的魔法"
    },
    {
      "start": 1495.52,
      "end": 1498,
      "text": "做声音重设计非常有趣。"
    },
    {
      "start": 1498,
      "end": 1500.24,
      "text": "原 VFX 由 Jong Woo Jeong 制作，"
    },
    {
      "start": 1500.24,
      "end": 1502,
      "text": "非常感谢他。我也知道"
    },
    {
      "start": 1502,
      "end": 1504.4,
      "text": "制作这些声音构件时"
    },
    {
      "start": 1504.4,
      "end": 1505.84,
      "text": "可能有不少步骤"
    },
    {
      "start": 1505.84,
      "end": 1507.76,
      "text": "被我略过或忘了"
    },
    {
      "start": 1507.76,
      "end": 1509.36,
      "text": "说明。如果有"
    },
    {
      "start": 1509.36,
      "end": 1511.039,
      "text": "任何问题，请留言，"
    },
    {
      "start": 1511.039,
      "end": 1512.799,
      "text": "我会尽快回复。"
    },
    {
      "start": 1512.799,
      "end": 1514.4,
      "text": "希望这期内容"
    },
    {
      "start": 1514.4,
      "end": 1516.24,
      "text": "有趣，也希望大家"
    },
    {
      "start": 1516.24,
      "end": 1518.4,
      "text": "有所收获。"
    }
  ]
}
